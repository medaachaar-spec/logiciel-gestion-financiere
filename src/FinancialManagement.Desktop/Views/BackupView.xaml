<UserControl x:Class="FinancialManagement.Desktop.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Sauvegardes et restauration" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,16"
                       Text="Protégez les données de l'entreprise ou restaurez une sauvegarde existante."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <Border Padding="16" Margin="0,0,0,12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Sauvegarde locale" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Crée une copie sûre dans le dossier de sauvegardes de l'application. Une sauvegarde automatique est également vérifiée au démarrage, au maximum une fois par jour." />
                    <Button Width="190" Height="36" HorizontalAlignment="Left"
                            Content="Créer une sauvegarde"
                            Command="{Binding CreateLocalBackupCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Créer une sauvegarde locale" />
                </StackPanel>
            </Border>

            <Border Padding="16" Margin="0,0,0,12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Sauvegarde externe" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Choisissez une clé USB, un disque externe ou un autre dossier disponible." />
                    <Button Width="300" Height="36" HorizontalAlignment="Left"
                            Content="Sauvegarder vers un emplacement externe"
                            Command="{Binding CreateExternalBackupCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="Sauvegarder sur un support externe" />
                </StackPanel>
            </Border>

            <Border Padding="16" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Restaurer une sauvegarde" FontSize="17" FontWeight="SemiBold" />
                    <Border Margin="0,8,0,12" Padding="10" Background="#FFF7E8" CornerRadius="6">
                        <TextBlock Text="Attention : cette opération remplacera les données actuelles. Une confirmation explicite sera demandée avant toute restauration."
                                   TextWrapping="Wrap" Foreground="#7A4A00" />
                    </Border>
                    <Button Width="220" Height="36" HorizontalAlignment="Left"
                            Content="Choisir une sauvegarde"
                            Command="{Binding SelectRestoreBackupCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <TextBlock Margin="0,10,0,0" Text="Fichier sélectionné" FontWeight="SemiBold"
                               Visibility="{Binding HasSelectedRestorePath, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Margin="0,3,0,12" Text="{Binding SelectedRestorePath}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding HasSelectedRestorePath, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Width="220" Height="36" HorizontalAlignment="Left"
                            Content="Restaurer la sauvegarde"
                            Command="{Binding RestoreBackupCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Restaurer la sauvegarde sélectionnée" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Opération en cours…" Margin="0,0,0,6" />
                <ProgressBar Height="4" IsIndeterminate="True" />
            </StackPanel>
            <Border Margin="0,14,0,0" Padding="10" Background="#F0FBF5" CornerRadius="6"
                    Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap" Foreground="#176B3A" />
            </Border>
            <Border Margin="0,14,0,0" Padding="10" Background="#FFF7F7" CornerRadius="6"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
