<UserControl x:Class="FinancialManagement.Desktop.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="fr-FR"
             Loaded="SalesView_OnLoaded">
    <UserControl.Resources>
        <Style x:Key="SalesDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundBrush}" />
        </Style>
        <Style x:Key="SalesDataGridCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid IsEnabled="{Binding IsCreateFormVisible, Converter={StaticResource InverseBooleanConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ventes" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Consultez et enregistrez les ventes de l'activité."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,4,12,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="138"
                        Height="36"
                        Content="Nouvelle vente"
                        Command="{Binding ShowCreateFormCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.Name="Créer une nouvelle vente"
                        Visibility="{Binding CanCreateSales, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="98" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Label Content="Recherche"
                               Target="{Binding ElementName=SalesSearchInput}"
                               Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="SalesSearchInput"
                                 Height="36"
                                 TabIndex="0"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 AutomationProperties.Name="Rechercher par référence ou client">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <Label Content="Date début"
                               Target="{Binding ElementName=SalesFromDateInput}"
                               Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker x:Name="SalesFromDateInput"
                                    TabIndex="1"
                                    SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedDateFormat="Short"
                                    Style="{StaticResource InputDatePickerStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <Label Content="Date fin"
                               Target="{Binding ElementName=SalesToDateInput}"
                               Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker x:Name="SalesToDateInput"
                                    TabIndex="2"
                                    SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedDateFormat="Short"
                                    Style="{StaticResource InputDatePickerStyle}" />
                    </StackPanel>
                    <Button Grid.Column="3"
                            Height="36"
                            Margin="0,25,10,0"
                            TabIndex="3"
                            Content="Appliquer"
                            Command="{Binding ApplyFiltersCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Appliquer les filtres de ventes" />
                    <Button Grid.Column="4"
                            Height="36"
                            Margin="0,25,0,0"
                            TabIndex="4"
                            Content="Réinitialiser"
                            Command="{Binding ResetFiltersCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="Réinitialiser les filtres de ventes" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <StackPanel Margin="0,0,0,10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Chargement des ventes…" Margin="0,0,0,6" />
                    <ProgressBar Height="4" IsIndeterminate="True" />
                </StackPanel>

                <Border Background="{StaticResource SuccessSoftBrush}"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,10"
                        Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="{Binding ListErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Visibility="{Binding HasListError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Sales}"
                          Style="{StaticResource SalesDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ClipboardCopyMode="None"
                          EnableRowVirtualization="True"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Liste des ventes"
                          Visibility="{Binding HasSales, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding SaleDate}" Width="88"
                                            ElementStyle="{StaticResource SalesDataGridCellTextStyle}" />
                        <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="1.1*"
                                            ElementStyle="{StaticResource SalesDataGridCellTextStyle}" />
                        <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="1.25*"
                                            ElementStyle="{StaticResource SalesDataGridCellTextStyle}" />
                        <DataGridTextColumn Header="Montant" Binding="{Binding Amount}" Width="110"
                                            ElementStyle="{StaticResource SalesDataGridCellTextStyle}" />
                        <DataGridTextColumn Header="Échéance" Binding="{Binding DueDate}" Width="94"
                                            ElementStyle="{StaticResource SalesDataGridCellTextStyle}" />
                        <DataGridTextColumn Header="Observation" Binding="{Binding Observation}" Width="1.2*"
                                            ElementStyle="{StaticResource SalesDataGridCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14" />
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TotalCountDescription}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Grid.Column="1"
                        Width="104"
                        Height="34"
                        Content="Précédent"
                        Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="Page précédente" />
                <TextBlock Grid.Column="2"
                           Width="110"
                           Text="{Binding PageDescription}"
                           TextAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Grid.Column="3"
                        Width="104"
                        Height="34"
                        Content="Suivant"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="Page suivante" />
            </Grid>
        </Grid>

        <Grid Background="#66000000"
              Visibility="{Binding IsCreateFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="SaleCreateDialog"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="24"
                    MaxWidth="820"
                    MaxHeight="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="22">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Nouvelle vente" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Les champs marqués d'un astérisque sont obligatoires."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding FormErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Montant total *"
                                       Target="{Binding ElementName=SaleTotalInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="SaleTotalInput"
                                         Height="36"
                                         TabIndex="10"
                                         Text="{Binding TotalAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         AutomationProperties.Name="Montant total de la vente" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Date d'échéance (facultative)"
                                       Target="{Binding ElementName=SaleDueDateInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <DatePicker x:Name="SaleDueDateInput"
                                            TabIndex="11"
                                            SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                            SelectedDateFormat="Short"
                                            Style="{StaticResource InputDatePickerStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,14,0,0">
                            <Label Content="Observation (facultative)"
                                   Target="{Binding ElementName=SaleObservationInput}"
                                   Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="SaleObservationInput"
                                     Height="54"
                                     TabIndex="12"
                                     Padding="12,7"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding SaleObservation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}" />
                        </StackPanel>

                        <Border Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Client" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock Text="{Binding ClientSelectionDescription}"
                                                   Margin="0,4,0,0"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Width="118"
                                            Height="32"
                                            Content="Vente anonyme"
                                            Command="{Binding RemoveClientCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="{Binding HasSelectedClient, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>

                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding CanViewClients, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <Label Content="Rechercher un client"
                                                   Target="{Binding ElementName=ClientSearchInput}"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="ClientSearchInput"
                                                     Height="36"
                                                     TabIndex="13"
                                                     Text="{Binding ClientSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     AutomationProperties.Name="Rechercher un client par nom ou identifiant">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding SearchClientsCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Height="36"
                                                Margin="0,25,0,0"
                                                TabIndex="14"
                                                Content="Rechercher"
                                                Command="{Binding SearchClientsCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock Text="Recherche en cours…"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding IsLookingUpClients, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding LookupErrorMessage}"
                                               Foreground="{StaticResource DangerBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding HasLookupError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ListBox ItemsSource="{Binding ClientResults}"
                                             SelectedItem="{Binding SelectedLookupResult, Mode=TwoWay}"
                                             DisplayMemberPath="DisplayLabel"
                                             MaxHeight="104"
                                             Margin="0,8,0,0"
                                             TabIndex="15"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Résultats de recherche clients" />
                                    <Button Width="150"
                                            Height="32"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            TabIndex="16"
                                            Content="Choisir ce client"
                                            Command="{Binding SelectClientCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>

                                <TextBlock Text="Sélection d'un client non disponible. La vente anonyme reste possible."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           Visibility="{Binding ShowClientLookupUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <CheckBox Content="Enregistrer un paiement initial"
                                          IsChecked="{Binding HasInitialPayment, Mode=TwoWay}"
                                          IsEnabled="{Binding HasSelectedClient}"
                                          TabIndex="17"
                                          FontWeight="SemiBold" />
                                <TextBlock Text="Une vente anonyme doit être payée intégralement à la création."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding IsAnonymousSale, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding ShowInitialPaymentFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="Montant du paiement *"
                                                   Target="{Binding ElementName=InitialPaymentInput}"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="InitialPaymentInput"
                                                     Height="36"
                                                     TabIndex="18"
                                                     Text="{Binding InitialPaymentAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="Mode de paiement *"
                                                   Target="{Binding ElementName=PaymentMethodInput}"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="PaymentMethodInput"
                                                      TabIndex="19"
                                                      ItemsSource="{Binding PaymentMethods}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                                                      Style="{StaticResource InputComboBoxStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,12,0,0">
                                        <Label Content="Observation du paiement (facultative)"
                                               Target="{Binding ElementName=PaymentObservationInput}"
                                               Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="PaymentObservationInput"
                                                 Height="36"
                                                 TabIndex="20"
                                                 Text="{Binding PaymentObservation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Enregistrement de la vente…" Margin="0,0,0,6" />
                            <ProgressBar Height="4" IsIndeterminate="True" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button Width="96"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    TabIndex="22"
                                    Content="Annuler"
                                    Command="{Binding CancelCreateFormCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Width="150"
                                    Height="36"
                                    TabIndex="21"
                                    Content="Enregistrer"
                                    Command="{Binding CreateSaleCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="Enregistrer la vente" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
