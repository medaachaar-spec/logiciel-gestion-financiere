<UserControl x:Class="FinancialManagement.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:FinancialManagement.Desktop.ViewModels"
             xmlns:views="clr-namespace:FinancialManagement.Desktop.Views"
             mc:Ignorable="d"
             Language="fr-FR"
             Loaded="DashboardView_OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DashboardBlueSoftBrush" Color="#EEF5FE" />
        <SolidColorBrush x:Key="DashboardPurpleSoftBrush" Color="#F3F0FA" />
        <SolidColorBrush x:Key="DashboardOrangeSoftBrush" Color="#FFF4ED" />
        <SolidColorBrush x:Key="DashboardGreenSoftBrush" Color="#EDF8F2" />
        <SolidColorBrush x:Key="DashboardChartSurfaceBrush" Color="#FAFCFE" />
        <SolidColorBrush x:Key="DashboardChartBorderBrush" Color="#EDF1F5" />

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#E3E9EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.065" Color="#17212B" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DashboardSelectorStyle" TargetType="ComboBox" BasedOn="{StaticResource InputComboBoxStyle}">
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="Height" Value="40" />
        </Style>

        <Style x:Key="DashboardPeriodButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardActionLinkStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{StaticResource DashboardBlueSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Background="#AAB5BF" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#7E8D9A" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardPageScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DashboardScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PrimaryMetricTemplate" DataType="{x:Type vm:DashboardMetricViewModel}">
            <Border Style="{StaticResource DashboardCardStyle}"
                    Margin="0,0,14,14"
                    Padding="18"
                    MinHeight="120">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="9"
                                Background="{StaticResource DashboardBlueSoftBrush}">
                            <TextBlock Text="{Binding IconGlyph}"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,11,0,8">
                        <TextBlock Text="{Binding Value}" FontSize="28">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPositiveResult}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNegativeResult}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Viewbox>
                    <TextBlock Grid.Row="2" Text="{Binding Subtitle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PositionMetricTemplate" DataType="{x:Type vm:DashboardMetricViewModel}">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#E3E9EF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,0,12,12"
                    Padding="17"
                    MinHeight="112">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Left" Margin="0,10,0,6">
                        <TextBlock Text="{Binding Value}" FontSize="21"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Viewbox>
                    <TextBlock Grid.Row="2" Text="{Binding Subtitle}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PartyBalanceTemplate" DataType="{x:Type vm:DashboardPartyBalanceViewModel}">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid AutomationProperties.Name="{Binding AccessibilityName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PartyName}" Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding PartyName}" />
                    <TextBlock Grid.Column="1" Text="{Binding OutstandingAmount}"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="12,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                   Padding="0,0,10,0">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource DashboardPageScrollBarStyle}" />
        </ScrollViewer.Resources>
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Votre activité et vos positions financières en un coup d'œil"
                               Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Width="42" Height="40" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Actualiser toutes les données"
                        AutomationProperties.Name="Actualiser le tableau de bord">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="15" />
                </Button>
            </Grid>

            <Border Style="{StaticResource DashboardCardStyle}" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PeriodOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding DisplayName}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectPeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"
                                                 GroupName="DashboardPeriod"
                                                 Style="{StaticResource DashboardPeriodButtonStyle}"
                                                 Height="34" Padding="13,0" Margin="0,0,6,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,9,0,0"
                                   Visibility="{Binding IsCustomPeriod, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DatePicker SelectedDate="{Binding CustomStartDate}" Width="145" Height="34"
                                        Margin="0,0,8,0" AutomationProperties.Name="Date de début" />
                            <DatePicker SelectedDate="{Binding CustomEndDate}" Width="145" Height="34"
                                        Margin="0,0,8,0" AutomationProperties.Name="Date de fin" />
                            <Button Content="Appliquer" Height="34" Padding="14,0"
                                    Command="{Binding ApplyCustomCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="135" Margin="18,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Actualisation…" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" FontSize="11" Margin="0,0,0,7" />
                        <ProgressBar Height="4" IsIndeterminate="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#FFF1F1" BorderBrush="#F2CDCD" BorderThickness="1" CornerRadius="10"
                    Padding="13" Margin="0,0,0,18"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontSize="13" TextWrapping="Wrap" />
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding PeriodDescription}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11.5" Margin="2,0,0,8" />
                <ItemsControl ItemsSource="{Binding PrimaryMetrics}" ItemTemplate="{StaticResource PrimaryMetricTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Grid Margin="0,10,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Padding="20" MinHeight="308">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Évolution de l'activité" Style="{StaticResource DashboardSectionTitleStyle}" />
                                <TextBlock Text="{Binding ChartGranularityDescription, StringFormat=Ventes\, achats et dépenses · {0}}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Padding="8,6,8,2"
                                    Background="{StaticResource DashboardChartSurfaceBrush}"
                                    BorderBrush="{StaticResource DashboardChartBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <lvc:CartesianChart x:Name="DashboardActivityChart"
                                                        Series="{Binding ActivitySeries}"
                                                        XAxes="{Binding ActivityXAxes}"
                                                        YAxes="{Binding MoneyYAxes}"
                                                        LegendPosition="Bottom"
                                                        LegendTextSize="10"
                                                        TooltipPosition="Top"
                                                        Margin="4,0"
                                                        AnimationsSpeed="0:0:0.25"
                                                        Visibility="{Binding HasActivityData, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Border x:Name="DashboardActivityEmptyState"
                                            Background="#F8FAFC" CornerRadius="10" Margin="0,2,0,38"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding HasActivityData, Converter={StaticResource InverseBooleanConverter}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFontFamily}"
                                                       FontSize="24" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Aucune activité sur cette période" Margin="0,8,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Padding="20" MinHeight="308">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="Encaissements et paiements"
                                           Style="{StaticResource DashboardSectionTitleStyle}" />
                                <TextBlock Grid.Row="1" Text="{Binding ChartGranularityDescription, StringFormat=Flux clients et fournisseurs · {0}}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,8,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="12,4,0,0">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="ENCAISSEMENTS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9.5" />
                                        <TextBlock Text="{Binding CustomerCollectionsTotal}" Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PAIEMENTS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9.5" />
                                        <TextBlock Text="{Binding SupplierPaymentsTotal}" Foreground="{StaticResource AttentionBrush}"
                                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Padding="8,6,8,2"
                                    Background="{StaticResource DashboardChartSurfaceBrush}"
                                    BorderBrush="{StaticResource DashboardChartBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <lvc:CartesianChart x:Name="DashboardCashFlowChart"
                                                        Series="{Binding CashFlowSeries}"
                                                        XAxes="{Binding CashFlowXAxes}"
                                                        YAxes="{Binding MoneyYAxes}"
                                                        LegendPosition="Bottom"
                                                        LegendTextSize="10"
                                                        TooltipPosition="Top"
                                                        Margin="4,0"
                                                        AnimationsSpeed="0:0:0.25"
                                                        Visibility="{Binding HasCashFlowData, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Border x:Name="DashboardCashFlowEmptyState"
                                            Background="#F8FAFC" CornerRadius="10" Margin="0,2,0,38"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding HasCashFlowData, Converter={StaticResource InverseBooleanConverter}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IconFontFamily}"
                                                       FontSize="24" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Aucun flux sur cette période" Margin="0,8,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Situation financière actuelle" Style="{StaticResource DashboardSectionTitleStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding TreasuryStatus}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CurrentMetrics}" ItemTemplate="{StaticResource PositionMetricTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Grid Margin="0,2,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Padding="22" MinHeight="260">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CRÉANCES CLIENTS" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CustomerReceivablesTotal}" FontSize="25" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="{StaticResource DashboardBlueSoftBrush}">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFontFamily}" FontSize="17"
                                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding CustomerReceivableCountDescription}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,5" />
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding TopCustomerReceivables}"
                                          ItemTemplate="{StaticResource PartyBalanceTemplate}" />
                            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Margin="0,12,0,0" Padding="0,7,0,0">
                                <Button Content="Voir les créances  ›" HorizontalAlignment="Right"
                                        Command="{Binding OpenCustomerReceivablesCommand}"
                                        Style="{StaticResource DashboardActionLinkStyle}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Padding="22" MinHeight="260">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DETTES FOURNISSEURS" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SupplierPayablesTotal}" FontSize="25" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="{StaticResource DashboardOrangeSoftBrush}">
                                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFontFamily}" FontSize="17"
                                               Foreground="{StaticResource AttentionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding SupplierPayableCountDescription}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,5" />
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding TopSupplierPayables}"
                                          ItemTemplate="{StaticResource PartyBalanceTemplate}" />
                            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Margin="0,12,0,0" Padding="0,7,0,0">
                                <Button Content="Voir les dettes  ›" HorizontalAlignment="Right"
                                        Command="{Binding OpenSupplierPayablesCommand}"
                                        Style="{StaticResource DashboardActionLinkStyle}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <views:DueAlertsView DataContext="{Binding DueAlerts}" Margin="0,0,0,6" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
