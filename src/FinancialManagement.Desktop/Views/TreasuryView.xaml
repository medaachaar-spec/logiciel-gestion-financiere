<UserControl x:Class="FinancialManagement.Desktop.Views.TreasuryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="fr-FR"
             Loaded="TreasuryView_OnLoaded">
    <UserControl.Resources>
        <Style x:Key="TreasuryValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TreasuryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinHeight" Value="104" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Caisse &amp; Banque"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Situation réelle de trésorerie et transferts internes."
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,6,12,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="112"
                        Height="36"
                        Content="Actualiser"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.Name="Actualiser la trésorerie" />
            </Grid>

            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,0,16">
                <TextBlock Text="Chargement de la trésorerie…" Margin="0,0,0,8" />
                <ProgressBar Height="4" IsIndeterminate="True" />
            </StackPanel>

            <Border Background="{StaticResource SuccessSoftBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="{StaticResource SuccessBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="{Binding SummaryErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Visibility="{Binding HasSummaryError, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Text="{Binding OperationErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Visibility="{Binding HasOperationError, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <StackPanel Visibility="{Binding ShowInitializedState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <UniformGrid Columns="3" Margin="0,0,0,18">
                    <Border Style="{StaticResource TreasuryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Caisse" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{Binding CashBalance}"
                                       Margin="0,12,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CashBalance}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TreasuryValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CashBalanceIsNegative}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TreasuryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Banque" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{Binding BankBalance}"
                                       Margin="0,12,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding BankBalance}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TreasuryValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BankBalanceIsNegative}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TreasuryCardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Trésorerie totale" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{Binding TotalTreasury}"
                                       Margin="0,12,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding TotalTreasury}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TreasuryValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalTreasuryIsNegative}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Informations d'ouverture" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding OpeningDescription}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="142"
                                Height="36"
                                Content="Nouveau transfert"
                                Command="{Binding ShowTransferFormCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Visibility="{Binding IsTransferFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Nouveau transfert" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <WrapPanel>
                            <StackPanel Width="190" Margin="0,0,16,14">
                                <Label Content="Compte source"
                                       Target="{Binding ElementName=TransferSourceInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="TransferSourceInput"
                                          TabIndex="0"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding AccountOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedFromAccount, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Width="190" Margin="0,0,16,14">
                                <Label Content="Compte destination"
                                       Target="{Binding ElementName=TransferDestinationInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="TransferDestinationInput"
                                          TabIndex="1"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding AccountOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedToAccount, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Width="190" Margin="0,0,16,14">
                                <Label Content="Montant"
                                       Target="{Binding ElementName=TransferAmountInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TransferAmountInput"
                                         TabIndex="2"
                                         Height="36"
                                         AutomationProperties.Name="Montant du transfert"
                                          Text="{Binding TransferAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Margin="0,0,0,16">
                            <Label Content="Observation (facultative)"
                                   Target="{Binding ElementName=TransferObservationInput}"
                                   Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TransferObservationInput"
                                     TabIndex="3"
                                     Height="64"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Padding="12,8"
                                     Text="{Binding TransferObservation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="96" Height="36" Content="Annuler"
                                    TabIndex="5"
                                    Command="{Binding CancelTransferFormCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                            <Button Width="150" Height="36" Content="Enregistrer"
                                    TabIndex="4"
                                    Command="{Binding CreateTransferCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    Visibility="{Binding ShowUninitializedState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Trésorerie non initialisée" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Définissez une seule fois les soldes d'ouverture de la caisse et de la banque."
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="13"
                               Margin="0,6,0,16" />
                    <Button Width="180" Height="36" HorizontalAlignment="Left"
                            Content="Initialiser la trésorerie"
                            Command="{Binding ShowOpeningFormCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <Border Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,18,0,0"
                            Visibility="{Binding IsOpeningFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Width="190" Margin="0,0,16,14">
                                    <Label Content="Date d'ouverture"
                                           Target="{Binding ElementName=OpeningDateInput}"
                                           Style="{StaticResource FieldLabelStyle}" />
                                    <DatePicker x:Name="OpeningDateInput"
                                                TabIndex="0"
                                                Style="{StaticResource InputDatePickerStyle}"
                                                SelectedDate="{Binding OpeningDate, Mode=TwoWay}"
                                                SelectedDateFormat="Short" />
                                </StackPanel>
                                <StackPanel Width="190" Margin="0,0,16,14">
                                    <Label Content="Solde initial Caisse"
                                           Target="{Binding ElementName=OpeningCashInput}"
                                           Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="OpeningCashInput"
                                             TabIndex="1"
                                             Height="36"
                                             AutomationProperties.Name="Solde initial Caisse"
                                             Text="{Binding OpeningCashAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Width="190" Margin="0,0,16,14">
                                    <Label Content="Solde initial Banque"
                                           Target="{Binding ElementName=OpeningBankInput}"
                                           Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="OpeningBankInput"
                                             TabIndex="2"
                                             Height="36"
                                             AutomationProperties.Name="Solde initial Banque"
                                             Text="{Binding OpeningBankAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Width="96" Height="36" Content="Annuler"
                                        TabIndex="4"
                                        Command="{Binding CancelOpeningFormCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                                <Button Width="150" Height="36" Content="Initialiser"
                                        TabIndex="3"
                                        Command="{Binding CreateOpeningBalanceCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Enregistrement en cours…" Margin="0,0,0,8" />
                <ProgressBar Height="4" IsIndeterminate="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
