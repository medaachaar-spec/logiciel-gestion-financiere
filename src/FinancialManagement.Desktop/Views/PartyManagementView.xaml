<UserControl x:Class="FinancialManagement.Desktop.Views.PartyManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="fr-FR"
             Loaded="PartyManagementView_OnLoaded">
    <UserControl.Resources>
        <Style x:Key="PartyDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundBrush}" />
        </Style>
        <Style x:Key="PartyDataGridCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
        <Style x:Key="PartyMoneyDataGridCellTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PartyDataGridCellTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid IsEnabled="{Binding IsOverlayVisible, Converter={StaticResource InverseBooleanConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{Binding PageDescription}"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,4,12,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="170"
                        Height="36"
                        Content="{Binding NewItemLabel}"
                        Command="{Binding ShowCreateFormCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.Name="{Binding NewItemAutomationName}"
                        Visibility="{Binding CanCreate, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Label Content="Recherche"
                               Target="{Binding ElementName=PartySearchInput}"
                               Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PartySearchInput"
                                 Height="36"
                                 TabIndex="0"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 AutomationProperties.Name="{Binding SearchAutomationName}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Height="36"
                            Margin="0,25,10,0"
                            TabIndex="1"
                            Content="Appliquer"
                            Command="{Binding ApplySearchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Appliquer la recherche" />
                    <Button Grid.Column="2"
                            Height="36"
                            Margin="0,25,10,0"
                            TabIndex="2"
                            Content="Réinitialiser"
                            Command="{Binding ResetSearchCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="Réinitialiser la recherche" />
                    <Button Grid.Column="3"
                            Height="36"
                            Margin="0,25,0,0"
                            TabIndex="3"
                            Content="Actualiser"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="Actualiser la liste" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <StackPanel Margin="0,0,0,10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding LoadingMessage}" Margin="0,0,0,6" />
                    <ProgressBar Height="4" IsIndeterminate="True" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10"
                            Visibility="{Binding IsLoadingDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Chargement du détail…" Margin="0,0,0,6" />
                    <ProgressBar Height="4" IsIndeterminate="True" />
                </StackPanel>
                <Border Background="{StaticResource SuccessSoftBrush}"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,10"
                        Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding ListErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Visibility="{Binding HasListError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <Grid Grid.Row="3">
                <DataGrid x:Name="PartyDataGrid"
                          ItemsSource="{Binding Items}"
                          Style="{StaticResource PartyDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ClipboardCopyMode="None"
                          EnableRowVirtualization="True"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="{Binding ListAutomationName}"
                          Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="1.35*"
                                            ElementStyle="{StaticResource PartyDataGridCellTextStyle}" />
                        <DataGridTextColumn Header="Téléphone" Binding="{Binding PhoneDisplay}" Width="1.05*"
                                            ElementStyle="{StaticResource PartyDataGridCellTextStyle}" />
                        <DataGridTextColumn Header="Société" Binding="{Binding CompanyDisplay}" Width="1.2*"
                                            ElementStyle="{StaticResource PartyDataGridCellTextStyle}" />
                        <DataGridTextColumn Binding="{Binding CurrentBalanceDisplay}" Width="1.1*"
                                            ElementStyle="{StaticResource PartyMoneyDataGridCellTextStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding DataContext.BalanceColumnHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Actions" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Width="76" Height="28" Margin="0,0,8,0"
                                                Content="Modifier"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                AutomationProperties.Name="Modifier"
                                                Visibility="{Binding DataContext.CanModify, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Width="82" Height="28"
                                                Content="Supprimer"
                                                Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                AutomationProperties.Name="Supprimer définitivement"
                                                Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14" />
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TotalCountDescription}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Grid.Column="1" Width="104" Height="34"
                        Content="Précédent"
                        Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="Page précédente" />
                <TextBlock Grid.Column="2" Width="110"
                           Text="{Binding PageDescriptionText}"
                           TextAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Grid.Column="3" Width="104" Height="34"
                        Content="Suivant"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="Page suivante" />
            </Grid>
        </Grid>

        <Grid Background="#66000000"
              Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="20"
                    MaxWidth="760"
                    MaxHeight="570"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    KeyboardNavigation.TabNavigation="Cycle">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="22">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FormTitle}" FontSize="22" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Width="90" Height="34"
                                    Content="Annuler"
                                    Command="{Binding CancelFormCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.Name="Fermer le formulaire" />
                        </Grid>

                        <TextBlock Text="{Binding FormErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Nom *" Target="{Binding ElementName=PartyNameInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="PartyNameInput" Height="36" TabIndex="10"
                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         AutomationProperties.Name="Nom obligatoire" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Téléphone" Target="{Binding ElementName=PartyPhoneInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="PartyPhoneInput" Height="36" TabIndex="11"
                                         Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         AutomationProperties.Name="Téléphone facultatif" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,14,0,0">
                            <Label Content="Adresse" Target="{Binding ElementName=PartyAddressInput}"
                                   Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="PartyAddressInput" Height="52" TabIndex="12"
                                     Padding="12,7" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     AutomationProperties.Name="Adresse facultative" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Société" Target="{Binding ElementName=PartyCompanyInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="PartyCompanyInput" Height="36" TabIndex="13"
                                         Text="{Binding Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         AutomationProperties.Name="Société facultative" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Identifiant" Target="{Binding ElementName=PartyIdentifierInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="PartyIdentifierInput" Height="36" TabIndex="14"
                                         Text="{Binding Identifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         AutomationProperties.Name="Identifiant facultatif" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,14,0,0">
                            <Label Content="Observation" Target="{Binding ElementName=PartyObservationInput}"
                                   Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="PartyObservationInput" Height="58" TabIndex="15"
                                     Padding="12,7" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding Observation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     AutomationProperties.Name="Observation facultative" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding SavingMessage}" Margin="0,0,0,6" />
                            <ProgressBar Height="4" IsIndeterminate="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Width="96" Height="36" Margin="0,0,10,0" TabIndex="17"
                                    Content="Annuler"
                                    Command="{Binding CancelFormCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Width="190" Height="36" TabIndex="16"
                                    Content="{Binding SaveButtonLabel}"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="{Binding SaveButtonLabel}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Background="#66000000"
              Visibility="{Binding IsDeleteConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Margin="24"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="{Binding DeleteConfirmationQuestion}"
                               FontSize="21"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DeleteConfirmationDescription}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding DeleteErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasDeleteError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding IsDeleting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Suppression en cours…" Margin="0,0,0,6" />
                        <ProgressBar Height="4" IsIndeterminate="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Width="96" Height="36" Margin="0,0,10,0" TabIndex="21"
                                Content="Annuler"
                                Command="{Binding CancelDeleteCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Width="190" Height="36" TabIndex="20"
                                Content="Supprimer définitivement"
                                Command="{Binding ConfirmDeleteCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                AutomationProperties.Name="Confirmer la suppression définitive" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
