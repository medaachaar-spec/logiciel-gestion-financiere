<UserControl x:Class="FinancialManagement.Desktop.Views.AdministrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="AdministrationView_OnLoaded"
             Unloaded="AdministrationView_OnUnloaded">
    <Grid>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Administration" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Text="Gérez les employés, leurs permissions et les obligations initiales."
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Width="140" Height="4" IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <TabControl Grid.Row="1" Margin="0,14,0,0">
                    <TabItem Header="Utilisateurs">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Comptes utilisateurs" FontSize="18" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Width="100" Height="34" Margin="10,0,8,0"
                                        Content="Actualiser" Command="{Binding RefreshCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="2" Width="155" Height="34" Content="Créer un employé"
                                        Command="{Binding ShowCreateEmployeeCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <Border Padding="8" Background="#FFF7F7" CornerRadius="6"
                                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Border Padding="8" Background="{StaticResource SuccessSoftBrush}" CornerRadius="6"
                                        Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.95*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.05*" />
                                </Grid.ColumnDefinitions>
                                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                                          RowHeight="38" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          AutomationProperties.Name="Liste des utilisateurs">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nom" Binding="{Binding FullName}" Width="1.2*" />
                                        <DataGridTextColumn Header="Identifiant" Binding="{Binding Username}" Width="*" />
                                        <DataGridTextColumn Header="Rôle" Binding="{Binding RoleLabel}" Width="92" />
                                        <DataGridTextColumn Header="État" Binding="{Binding StatusLabel}" Width="92" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Column="2" Padding="14" Background="{StaticResource BackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Permissions" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedUserDescription}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding PermissionRows}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="34"
                                                  IsEnabled="{Binding CanEditPermissions}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Module" Binding="{Binding ModuleLabel}" Width="*" IsReadOnly="True" />
                                                <DataGridCheckBoxColumn Header="Voir" Binding="{Binding CanView, UpdateSourceTrigger=PropertyChanged}" Width="54" />
                                                <DataGridCheckBoxColumn Header="Créer" Binding="{Binding CanCreate, UpdateSourceTrigger=PropertyChanged}" Width="58">
                                                    <DataGridCheckBoxColumn.ElementStyle>
                                                        <Style TargetType="CheckBox"><Setter Property="IsEnabled" Value="{Binding CanUseDependentPermissions}" /></Style>
                                                    </DataGridCheckBoxColumn.ElementStyle>
                                                    <DataGridCheckBoxColumn.EditingElementStyle>
                                                        <Style TargetType="CheckBox"><Setter Property="IsEnabled" Value="{Binding CanUseDependentPermissions}" /></Style>
                                                    </DataGridCheckBoxColumn.EditingElementStyle>
                                                </DataGridCheckBoxColumn>
                                                <DataGridCheckBoxColumn Header="Modifier" Binding="{Binding CanModify, UpdateSourceTrigger=PropertyChanged}" Width="68">
                                                    <DataGridCheckBoxColumn.ElementStyle>
                                                        <Style TargetType="CheckBox"><Setter Property="IsEnabled" Value="{Binding CanUseDependentPermissions}" /></Style>
                                                    </DataGridCheckBoxColumn.ElementStyle>
                                                    <DataGridCheckBoxColumn.EditingElementStyle>
                                                        <Style TargetType="CheckBox"><Setter Property="IsEnabled" Value="{Binding CanUseDependentPermissions}" /></Style>
                                                    </DataGridCheckBoxColumn.EditingElementStyle>
                                                </DataGridCheckBoxColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Grid.Row="2" Margin="0,10,0,0" Height="34"
                                                Content="Enregistrer les permissions" Command="{Binding SavePermissionsCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Width="150" Height="34" Margin="0,0,8,0"
                                        Content="{Binding SetActiveButtonLabel}" Command="{Binding RequestSetActiveCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Width="180" Height="34" Content="Réinitialiser le mot de passe"
                                        Command="{Binding ShowResetPasswordCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Créances initiales">
                        <views:InitialObligationView xmlns:views="clr-namespace:FinancialManagement.Desktop.Views"
                                                     Margin="10" DataContext="{Binding CustomerReceivables}" />
                    </TabItem>

                    <TabItem Header="Dettes initiales">
                        <views:InitialObligationView xmlns:views="clr-namespace:FinancialManagement.Desktop.Views"
                                                     Margin="10" DataContext="{Binding SupplierPayables}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Grid Background="#66000000"
              Visibility="{Binding IsCreateEmployeeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="500" Padding="24" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Créer un employé" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,12" Text="Le rôle Employé est appliqué automatiquement."
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border Padding="8" Background="#FFF7F7" CornerRadius="6"
                            Visibility="{Binding HasCreateEmployeeError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding CreateEmployeeError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                    </Border>
                    <Label Margin="0,10,0,0" Content="Nom complet *" Target="{Binding ElementName=EmployeeFullNameInput}"
                           Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="EmployeeFullNameInput" Height="38" TabIndex="20"
                             Text="{Binding EmployeeFullName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}" />
                    <Label Margin="0,10,0,0" Content="Nom d'utilisateur *" Target="{Binding ElementName=EmployeeUsernameInput}"
                           Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="EmployeeUsernameInput" Height="38" TabIndex="21"
                             Text="{Binding EmployeeUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}" />
                    <Label Margin="0,10,0,0" Content="Mot de passe *" Target="{Binding ElementName=EmployeePasswordInput}"
                           Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="EmployeePasswordInput" Height="38" TabIndex="22"
                                 Style="{StaticResource InputPasswordBoxStyle}" />
                    <Label Margin="0,10,0,0" Content="Confirmer le mot de passe *"
                           Target="{Binding ElementName=EmployeePasswordConfirmationInput}"
                           Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="EmployeePasswordConfirmationInput" Height="38" TabIndex="23"
                                 Style="{StaticResource InputPasswordBoxStyle}" />
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="96" Height="34" Margin="0,0,10,0" Content="Annuler"
                                Command="{Binding CancelCreateEmployeeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Width="150" Height="34" Content="Créer l'employé" Click="CreateEmployeeButton_OnClick"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="#66000000"
              Visibility="{Binding IsSetActiveConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="480" Padding="24" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding SetActiveConfirmationTitle}" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding SetActiveConfirmationDescription}"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding SetActiveError}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSetActiveError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="96" Height="34" Margin="0,0,10,0" Content="Annuler"
                                Command="{Binding CancelSetActiveCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Width="140" Height="34" Content="{Binding SetActiveConfirmationButton}"
                                Command="{Binding ConfirmSetActiveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="#66000000"
              Visibility="{Binding IsResetPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="500" Padding="24" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="{Binding ResetPasswordTitle}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,12" Text="Le mot de passe actuel ne sera jamais affiché."
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ResetPasswordError}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasResetPasswordError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Label Margin="0,10,0,0" Content="Nouveau mot de passe *" Target="{Binding ElementName=ResetPasswordInput}"
                           Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="ResetPasswordInput" Height="38" TabIndex="30"
                                 Style="{StaticResource InputPasswordBoxStyle}" />
                    <Label Margin="0,10,0,0" Content="Confirmer le mot de passe *"
                           Target="{Binding ElementName=ResetPasswordConfirmationInput}"
                           Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="ResetPasswordConfirmationInput" Height="38" TabIndex="31"
                                 Style="{StaticResource InputPasswordBoxStyle}" />
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="96" Height="34" Margin="0,0,10,0" Content="Annuler"
                                Command="{Binding CancelResetPasswordCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Width="180" Height="34" Content="Réinitialiser" Click="ResetPasswordButton_OnClick"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
