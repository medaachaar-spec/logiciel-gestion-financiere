<UserControl x:Class="FinancialManagement.Desktop.Views.PaymentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="fr-FR"
             Loaded="PaymentManagementView_OnLoaded"
             Unloaded="PaymentManagementView_OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="PaymentDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundBrush}" />
        </Style>
        <Style x:Key="PaymentCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="7,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
        <Style x:Key="PaymentNumericCellTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PaymentCellTextStyle}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="PaymentNumericColumnHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="7,0" />
        </Style>
        <Style x:Key="PaymentHistoryColumnHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PaymentHistoryDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource PaymentHistoryColumnHeaderStyle}" />
        </Style>
        <Style x:Key="PaymentHistoryCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="9,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
        <Style x:Key="PaymentHistoryNumericCellTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PaymentHistoryCellTextStyle}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="PaymentHistoryNumericColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource PaymentHistoryColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="9,0" />
        </Style>
        <Style x:Key="PaymentSummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="PaymentSummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid IsEnabled="{Binding IsMainEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{Binding PageDescription}"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,4,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ShowAdvanceButton"
                                Width="156"
                                Height="36"
                                Margin="0,0,8,0"
                                Content="Affecter une avance"
                                Command="{Binding ShowAdvanceCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="Affecter le montant disponible d'un paiement existant"
                                Visibility="{Binding CanApplyAdvancePermission, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Width="170"
                                Height="36"
                                Content="{Binding NewPaymentLabel}"
                                Command="{Binding ShowCreateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="Créer un nouveau paiement"
                                Visibility="{Binding CanCreatePayment, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Width="250"
                               Margin="0,5,0,0"
                               Text="{Binding CreateUnavailableMessage}"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Visibility="{Binding ShowCreateUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="130" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="105" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="Recherche" Target="{Binding ElementName=PaymentSearchInput}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PaymentSearchInput"
                                 Height="34"
                                 TabIndex="0"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 AutomationProperties.Name="Rechercher un paiement">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <Label Content="Date début" Target="{Binding ElementName=PaymentFromDateInput}" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker x:Name="PaymentFromDateInput"
                                    TabIndex="1"
                                    SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                    SelectedDateFormat="Short"
                                    Style="{StaticResource InputDatePickerStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <Label Content="Date fin" Target="{Binding ElementName=PaymentToDateInput}" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker x:Name="PaymentToDateInput"
                                    TabIndex="2"
                                    SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                    SelectedDateFormat="Short"
                                    Style="{StaticResource InputDatePickerStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <Label Content="Statut" Target="{Binding ElementName=PaymentStatusFilter}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="PaymentStatusFilter"
                                  TabIndex="3"
                                  ItemsSource="{Binding FilterStatuses}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedFilterStatus, Mode=TwoWay}"
                                  Style="{StaticResource InputComboBoxStyle}" />
                    </StackPanel>
                    <Button Grid.Column="4"
                            Height="34"
                            Margin="0,24,8,0"
                            TabIndex="4"
                            Content="Rechercher"
                            Command="{Binding ApplyFiltersCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Grid.Column="5"
                            Height="34"
                            Margin="0,24,0,0"
                            TabIndex="5"
                            Content="Réinitialiser"
                            Command="{Binding ResetFiltersCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <StackPanel Margin="0,0,0,8"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Chargement des obligations…" Margin="0,0,0,5" />
                    <ProgressBar Height="4" IsIndeterminate="True" />
                </StackPanel>
                <Border Background="{StaticResource SuccessSoftBrush}"
                        CornerRadius="8"
                        Padding="9"
                        Margin="0,0,0,8"
                        Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding ListErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasListError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <Grid Grid.Row="3">
                <DataGrid x:Name="PaymentObligationDataGrid"
                          ItemsSource="{Binding Payments}"
                          Style="{StaticResource PaymentDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ClipboardCopyMode="None"
                          EnableRowVirtualization="True"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Liste des obligations"
                          Visibility="{Binding HasPayments, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" Width="86" ElementStyle="{StaticResource PaymentCellTextStyle}" />
                        <DataGridTemplateColumn Width="1.15*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.PartyColumnHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PartyName}" Style="{StaticResource PaymentCellTextStyle}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.1*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.ObligationReferenceHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Reference}" Style="{StaticResource PaymentCellTextStyle}" />
                                        <TextBlock Text="{Binding TargetType}" Margin="7,-3,7,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Montant" Binding="{Binding OriginalAmount}" Width="100" ElementStyle="{StaticResource PaymentNumericCellTextStyle}" HeaderStyle="{StaticResource PaymentNumericColumnHeaderStyle}" />
                        <DataGridTextColumn Header="Payé" Binding="{Binding PaidAmount}" Width="92" ElementStyle="{StaticResource PaymentNumericCellTextStyle}" HeaderStyle="{StaticResource PaymentNumericColumnHeaderStyle}" />
                        <DataGridTextColumn Header="Reste à payer" Binding="{Binding RemainingAmount}" Width="112" ElementStyle="{StaticResource PaymentNumericCellTextStyle}" HeaderStyle="{StaticResource PaymentNumericColumnHeaderStyle}" />
                        <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="145" ElementStyle="{StaticResource PaymentCellTextStyle}" />
                        <DataGridTemplateColumn Header="Actions" Width="166">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Height="28"
                                                Width="68"
                                                Margin="3"
                                                Content="Détails"
                                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                AutomationProperties.Name="Ouvrir le détail de l'obligation" />
                                        <Button Height="28"
                                                Width="78"
                                                Margin="3"
                                                Content="{Binding DataContext.PaymentActionLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Command="{Binding DataContext.ShowCreateForObligationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Visibility="{Binding HasRemaining, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="Créer un règlement pour cette obligation" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TotalCountDescription}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Grid.Column="1" Width="102" Height="32" Content="Précédent" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock Grid.Column="2" Width="105" Text="{Binding PageNumberDescription}" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="3" Width="102" Height="32" Content="Suivant" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Grid>

        <!-- Création -->
        <Grid Background="#66000000"
              Visibility="{Binding IsCreateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="PaymentCreateDialog"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="18"
                    MaxWidth="1040"
                    MaxHeight="630"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding NewPaymentLabel}" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CreateInstruction}"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding WorkflowErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HasWorkflowError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.75*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="10"
                                    IsEnabled="{Binding CanChangeCreateTarget}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="94" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <Label Content="{Binding PartyColumnHeader, StringFormat=Rechercher : {0}}" Target="{Binding ElementName=PartySearchInput}" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="PartySearchInput" Height="34" TabIndex="10"
                                                     Text="{Binding PartySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBoxStyle}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding SearchPartiesCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>
                                        <Button Grid.Column="1" Height="34" Margin="0,24,0,0" Content="Rechercher" Command="{Binding SearchPartiesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <ListBox ItemsSource="{Binding PartyResults}"
                                             SelectedItem="{Binding SelectedPartyResult, Mode=TwoWay}"
                                             DisplayMemberPath="DisplayLabel"
                                             MaxHeight="76"
                                             Margin="0,7,0,0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedPartyDescription}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Width="86" Height="28" Margin="8,0" Content="Choisir" Command="{Binding SelectPartyCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="2" Width="74" Height="28" Content="Changer" Command="{Binding ClearSelectedPartyCommand}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding HasSelectedParty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="Montant du paiement *" Target="{Binding ElementName=PaymentAmountInput}" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="PaymentAmountInput" Height="34" TabIndex="11"
                                                 Text="{Binding PaymentAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="Mode *" Target="{Binding ElementName=CreatePaymentMethodInput}" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="CreatePaymentMethodInput" TabIndex="12"
                                                  ItemsSource="{Binding PaymentMethods}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                                                  Style="{StaticResource InputComboBoxStyle}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <Label Content="Observation (facultative)" Target="{Binding ElementName=PaymentObservationInput}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="PaymentObservationInput" Height="34" TabIndex="13"
                                             Text="{Binding Observation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid IsEnabled="{Binding CanChangeCreateTarget}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="98" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Label Content="Rechercher une obligation" Target="{Binding ElementName=CreateObligationSearchInput}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="CreateObligationSearchInput" Height="32"
                                         Text="{Binding ObligationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchObligationsCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <Button Grid.Column="1" Height="32" Margin="0,24,0,0" Content="Actualiser" Command="{Binding SearchObligationsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Obligations}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  RowHeight="36"
                                  MaxHeight="205"
                                  Margin="0,6,0,0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Obligations à affecter"
                                  Visibility="{Binding HasObligations, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding TargetType}" Width="130" IsReadOnly="True" />
                                <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="1.1*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" Width="84" IsReadOnly="True" />
                                <DataGridTextColumn Header="Échéance" Binding="{Binding DueDate}" Width="84" IsReadOnly="True" />
                                <DataGridTextColumn Header="Montant initial" Binding="{Binding OriginalAmount}" Width="104" IsReadOnly="True" />
                                <DataGridTextColumn Header="Reste à payer" Binding="{Binding OutstandingAmount}" Width="104" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Montant à affecter" Width="132">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Margin="4" Padding="6,3"
                                                     Text="{Binding AllocationAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Montant à affecter" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1"
                                   Text="Aucune obligation disponible."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding ShowNoObligationState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="Total affecté" Style="{StaticResource PaymentSummaryLabelStyle}" />
                                <TextBlock Text="{Binding AllocatedSummary}" Style="{StaticResource PaymentSummaryValueStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Reste non affecté / avance" Style="{StaticResource PaymentSummaryLabelStyle}" />
                                <TextBlock Text="{Binding RemainingSummary}" Style="{StaticResource PaymentSummaryValueStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Text="Enregistrement…" Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Grid.Column="2" Width="92" Height="34" Margin="0,0,8,0" Content="Annuler" Command="{Binding CancelCreateCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="3" Width="164" Height="34" Content="Vérifier et continuer" Command="{Binding PrepareCreateCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Détail -->
        <Grid Background="#66000000"
              Visibility="{Binding IsDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="PaymentDetailDialog"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="24"
                    MaxWidth="940"
                    MaxHeight="570"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DetailTitle}" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DetailReference}" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding WorkflowErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasWorkflowError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,12">
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,12,8"><TextBlock x:Name="PaymentDetailPartyLabel" Text="{Binding DetailPartyLabel}" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding DetailParty}" Style="{StaticResource PaymentSummaryValueStyle}" TextTrimming="CharacterEllipsis" /></StackPanel>
                            <StackPanel Margin="0,0,12,8"><TextBlock Text="Origine" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding DetailTargetType}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                            <StackPanel Margin="0,0,12,8"><TextBlock Text="Date" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding DetailDate}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                            <StackPanel Margin="0,0,0,8"><TextBlock Text="Statut" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding DetailStatus}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Montant initial" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding DetailAmount}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Total payé" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding DetailPaidAmount}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Reste actuel" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding DetailRemainingAmount}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                        </UniformGrid>
                    </Border>
                    <TextBlock Grid.Row="3" Text="{Binding DetailHistoryTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,7" />
                    <DataGrid x:Name="PaymentHistoryDataGrid" Grid.Row="4" ItemsSource="{Binding DetailHistory}" Style="{StaticResource PaymentHistoryDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow" MaxHeight="266" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasDetailHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date / heure" Binding="{Binding PaymentTimestamp}" Width="125" ElementStyle="{StaticResource PaymentHistoryCellTextStyle}" />
                            <DataGridTextColumn Header="Référence paiement" Binding="{Binding PaymentReference}" Width="*" ElementStyle="{StaticResource PaymentHistoryCellTextStyle}" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding PaymentMethod}" Width="130" ElementStyle="{StaticResource PaymentHistoryCellTextStyle}" />
                            <DataGridTextColumn Header="Montant affecté" Binding="{Binding AllocatedAmount}" Width="120" ElementStyle="{StaticResource PaymentHistoryNumericCellTextStyle}" HeaderStyle="{StaticResource PaymentHistoryNumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="Cumul payé" Binding="{Binding CumulativePaidAmount}" Width="105" ElementStyle="{StaticResource PaymentHistoryNumericCellTextStyle}" HeaderStyle="{StaticResource PaymentHistoryNumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="Reste après paiement" Binding="{Binding RemainingAfterPayment}" Width="140" ElementStyle="{StaticResource PaymentHistoryNumericCellTextStyle}" HeaderStyle="{StaticResource PaymentHistoryNumericColumnHeaderStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="5" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Aucun règlement affecté à cette obligation." VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding HasDetailHistory, Converter={StaticResource InverseBooleanConverter}}" />
                        <Button Grid.Column="1" Width="86" Height="34" Content="Fermer" Command="{Binding CloseDetailCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Sélection du paiement contenant l'avance -->
        <Grid Background="#66000000"
              Visibility="{Binding IsAdvanceSourceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="AdvanceSourceDialog"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="22"
                    MaxWidth="1000"
                    MaxHeight="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Affecter une avance" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Sélectionnez un paiement existant qui conserve un montant disponible."
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Text="{Binding WorkflowErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasWorkflowError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid Grid.Row="2" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <Label Content="Référence ou tiers"
                                   Target="{Binding ElementName=AdvanceSourceSearchInput}"
                                   Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="AdvanceSourceSearchInput"
                                     Height="34"
                                     Text="{Binding AdvanceSourceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     AutomationProperties.Name="Rechercher un paiement avec un montant disponible">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchAdvanceSourcesCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Height="34"
                                Margin="0,24,0,0"
                                Content="Rechercher"
                                Command="{Binding SearchAdvanceSourcesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                    <Grid Grid.Row="3">
                        <DataGrid x:Name="AdvanceSourceDataGrid"
                                  ItemsSource="{Binding AdvanceSources}"
                                  SelectedItem="{Binding SelectedAdvanceSource, Mode=TwoWay}"
                                  Style="{StaticResource PaymentDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Paiements avec un montant disponible"
                                  Visibility="{Binding HasAdvanceSources, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="115" ElementStyle="{StaticResource PaymentCellTextStyle}" />
                                <DataGridTextColumn Header="Tiers" Binding="{Binding PartyName}" Width="*" ElementStyle="{StaticResource PaymentCellTextStyle}" />
                                <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate}" Width="85" ElementStyle="{StaticResource PaymentCellTextStyle}" />
                                <DataGridTextColumn Header="Mode" Binding="{Binding PaymentMethod}" Width="125" ElementStyle="{StaticResource PaymentCellTextStyle}" />
                                <DataGridTextColumn Header="Montant" Binding="{Binding Amount}" Width="100" ElementStyle="{StaticResource PaymentNumericCellTextStyle}" HeaderStyle="{StaticResource PaymentNumericColumnHeaderStyle}" />
                                <DataGridTextColumn Header="Déjà affecté" Binding="{Binding AllocatedAmount}" Width="105" ElementStyle="{StaticResource PaymentNumericCellTextStyle}" HeaderStyle="{StaticResource PaymentNumericColumnHeaderStyle}" />
                                <DataGridTextColumn Header="Disponible" Binding="{Binding AvailableAmount}" Width="105" ElementStyle="{StaticResource PaymentNumericCellTextStyle}" HeaderStyle="{StaticResource PaymentNumericColumnHeaderStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsLoadingAdvanceSources, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Chargement des paiements disponibles…" Margin="0,0,0,8" />
                            <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                        </StackPanel>
                        <TextBlock Text="{Binding AdvanceSourceEmptyMessage}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding ShowNoAdvanceSourceState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Le montant disponible reste rattaché au paiement sélectionné." />
                        <Button Grid.Column="1"
                                Width="90"
                                Height="34"
                                Margin="0,0,8,0"
                                Content="Annuler"
                                Command="{Binding CancelAdvanceSourceCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2"
                                Width="150"
                                Height="34"
                                Content="Choisir ce paiement"
                                Command="{Binding SelectAdvanceSourceCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Affectation d'avance -->
        <Grid Background="#66000000"
              Visibility="{Binding IsAdvanceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="PaymentAdvanceDialog"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="22"
                    MaxWidth="940"
                    MaxHeight="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Affecter l'avance" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DetailParty}" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding WorkflowErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasWorkflowError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid Grid.Row="2" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="105" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="{Binding AdvanceTargetSearchLabel}" Target="{Binding ElementName=AdvanceObligationSearchInput}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="AdvanceObligationSearchInput" Height="34" Text="{Binding ObligationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchObligationsCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <Button Grid.Column="1" Height="34" Margin="0,24,12,0" Content="Actualiser" Command="{Binding SearchObligationsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <StackPanel Grid.Column="2" MinWidth="140">
                            <TextBlock Text="Avance disponible" Style="{StaticResource PaymentSummaryLabelStyle}" />
                            <TextBlock Text="{Binding AdvanceAvailable}" Style="{StaticResource PaymentSummaryValueStyle}" FontSize="17" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3">
                        <DataGrid ItemsSource="{Binding Obligations}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="38" ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="{Binding HasObligations, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding TargetType}" Width="140" IsReadOnly="True" />
                                <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" Width="86" IsReadOnly="True" />
                                <DataGridTextColumn Header="Échéance" Binding="{Binding DueDate}" Width="86" IsReadOnly="True" />
                                <DataGridTextColumn Header="Reste à payer" Binding="{Binding OutstandingAmount}" Width="110" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Montant à affecter" Width="135">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Margin="4" Padding="6,3" Text="{Binding AllocationAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Montant d'avance à affecter" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding AdvanceTargetEmptyMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding ShowNoObligationState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,26,0"><TextBlock Text="Montant à affecter" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding AllocatedSummary}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                            <StackPanel><TextBlock Text="Reste d'avance après opération" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding RemainingSummary}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Width="90" Height="34" Margin="0,0,8,0" Content="Annuler" Command="{Binding CancelAdvanceCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" Width="150" Height="34" Content="Affecter l'avance" Command="{Binding ApplyAdvanceCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Confirmation de création -->
        <Grid Background="#88000000"
              Visibility="{Binding IsCreateConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Width="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Confirmer le paiement" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="Vérifiez le résumé avant l'enregistrement définitif." Margin="0,4,0,14" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,16,12"><TextBlock Text="{Binding PartyColumnHeader}" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding ConfirmationParty}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="Mode" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding ConfirmationPaymentMethod}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,16,12"><TextBlock Text="Montant" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding ConfirmationAmount}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="Montant affecté" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding ConfirmationAllocated}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,16,0"><TextBlock Text="Avance non affectée" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding ConfirmationAdvance}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="Obligations" Style="{StaticResource PaymentSummaryLabelStyle}" /><TextBlock Text="{Binding ConfirmationObligationCount}" Style="{StaticResource PaymentSummaryValueStyle}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding WorkflowErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding HasWorkflowError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Width="100" Height="34" Margin="0,0,8,0" Content="Retour" Command="{Binding CancelCreateConfirmationCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Width="168" Height="34" Content="Confirmer le paiement" Command="{Binding ConfirmCreateCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
