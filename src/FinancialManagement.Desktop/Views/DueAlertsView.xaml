<UserControl x:Class="FinancialManagement.Desktop.Views.DueAlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alerts="clr-namespace:FinancialManagement.Application.Alerts;assembly=FinancialManagement.Application"
             Language="fr-FR">
    <UserControl.Resources>
        <Style x:Key="DueAlertListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="DueAlertStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static alerts:FinancialDueAlertStatus.DueToday}">
                    <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static alerts:FinancialDueAlertStatus.Overdue}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="DueAlertItemTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" MinWidth="110" />
                        <ColumnDefinition Width="1.5*" MinWidth="135" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="135" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SourceTypeLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding PartyName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding DueDate}" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Column="3" Text="{Binding OutstandingAmount}" VerticalAlignment="Center" TextAlignment="Right" Margin="8,0" />
                    <StackPanel Grid.Column="4" Margin="8,0,0,0">
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource DueAlertStatusStyle}" />
                        <TextBlock Text="{Binding DaysLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Échéances à surveiller"
                               Style="{StaticResource PageTitleTextStyle}"
                               FontSize="21" />
                    <TextBlock Text="Créances clients et dettes fournisseurs arrivant à échéance ou en retard."
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="13"
                               Margin="0,5,12,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentDateDescription}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="170"
                        Height="36"
                        Content="Actualiser les échéances"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="Actualiser les échéances" />
            </Grid>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Chargement des échéances…" Margin="0,0,0,8" />
                <ProgressBar Height="4" IsIndeterminate="True" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Margin="0,18,0,0"
                  Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Aucune échéance à surveiller actuellement."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding HasAlerts, Converter={StaticResource InverseBooleanConverter}}" />

                <StackPanel Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontWeight="SemiBold" FontSize="15">
                        <Run Text="Clients — " />
                        <Run Text="{Binding TotalCustomerAlertCount, Mode=OneWay}" />
                        <Run Text=" alerte(s), dont " />
                        <Run Text="{Binding OverdueCustomerCount, Mode=OneWay}" />
                        <Run Text=" en retard" />
                    </TextBlock>
                    <ListBox ItemsSource="{Binding CustomerAlerts}"
                             ItemTemplate="{StaticResource DueAlertItemTemplate}"
                             ItemContainerStyle="{StaticResource DueAlertListItemStyle}"
                             MaxHeight="300"
                             Margin="0,8,0,20"
                             BorderBrush="{StaticResource BorderBrush}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True" />

                    <TextBlock FontWeight="SemiBold" FontSize="15">
                        <Run Text="Fournisseurs — " />
                        <Run Text="{Binding TotalSupplierAlertCount, Mode=OneWay}" />
                        <Run Text=" alerte(s), dont " />
                        <Run Text="{Binding OverdueSupplierCount, Mode=OneWay}" />
                        <Run Text=" en retard" />
                    </TextBlock>
                    <ListBox ItemsSource="{Binding SupplierAlerts}"
                             ItemTemplate="{StaticResource DueAlertItemTemplate}"
                             ItemContainerStyle="{StaticResource DueAlertListItemStyle}"
                             MaxHeight="300"
                             Margin="0,8,0,0"
                             BorderBrush="{StaticResource BorderBrush}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
