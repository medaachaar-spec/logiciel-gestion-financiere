<UserControl x:Class="FinancialManagement.Desktop.Views.DueAlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alerts="clr-namespace:FinancialManagement.Application.Alerts;assembly=FinancialManagement.Application"
             Language="fr-FR">
    <UserControl.Resources>
        <Style x:Key="DueAlertListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityName}" />
        </Style>
        <Style x:Key="DueAlertStatusPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#EEF5FE" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static alerts:FinancialDueAlertStatus.DueToday}">
                    <Setter Property="Background" Value="#FFF4E5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static alerts:FinancialDueAlertStatus.Overdue}">
                    <Setter Property="Background" Value="#FFF0F0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DueAlertStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static alerts:FinancialDueAlertStatus.DueToday}">
                    <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static alerts:FinancialDueAlertStatus.Overdue}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="DueAlertItemTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,10">
                <Grid ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel MinWidth="0" ClipToBounds="True">
                        <TextBlock Text="{Binding PartyName}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PartyName}" />
                        <TextBlock Text="{Binding ReferenceAndDueDate, Mode=OneWay}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Reference}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding OutstandingAmount}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextAlignment="Right" Margin="10,0" />
                    <Border Grid.Column="2" Style="{StaticResource DueAlertStatusPillStyle}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource DueAlertStatusTextStyle}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="#E7EBEF" BorderThickness="1" CornerRadius="14" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.07" Color="#17212B" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Échéances" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentDateDescription}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Width="38" Height="34" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" ToolTip="Actualiser les échéances"
                        AutomationProperties.Name="Actualiser les échéances"
                        AutomationProperties.HelpText="Actualise uniquement les échéances clients et fournisseurs">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
                </Button>
            </Grid>

            <WrapPanel Margin="0,14,0,0" Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="#FFF0F0" CornerRadius="9" Padding="10,7" Margin="0,0,8,6">
                    <TextBlock Text="{Binding OverdueSummary}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <Border Background="#FFF4E5" CornerRadius="9" Padding="10,7" Margin="0,0,8,6">
                    <TextBlock Text="{Binding DueTodaySummary}" Foreground="{StaticResource AttentionBrush}" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <Border Background="#EEF5FE" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
                    <TextBlock Text="{Binding UpcomingSummary}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                </Border>
            </WrapPanel>

            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Chargement des échéances…" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,7" />
                <ProgressBar Height="4" IsIndeterminate="True" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Margin="0,8,0,0" Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="#F8FAFC" CornerRadius="10" Padding="18"
                        Visibility="{Binding HasAlerts, Converter={StaticResource InverseBooleanConverter}}">
                    <TextBlock Text="Aucune échéance à surveiller dans la fenêtre configurée."
                               HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>

                <Grid Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MinWidth="0">
                        <Border Padding="8,4,8,7">
                            <TextBlock Text="{Binding CustomerSummary}" FontWeight="SemiBold" FontSize="12"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding CustomerSummary}" />
                        </Border>
                        <ListBox ItemsSource="{Binding CustomerAlerts}" ItemTemplate="{StaticResource DueAlertItemTemplate}"
                                 ItemContainerStyle="{StaticResource DueAlertListItemStyle}" MaxHeight="260"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" MinWidth="0">
                        <Border Padding="8,4,8,7">
                            <TextBlock Text="{Binding SupplierSummary}" FontWeight="SemiBold" FontSize="12"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SupplierSummary}" />
                        </Border>
                        <ListBox ItemsSource="{Binding SupplierAlerts}" ItemTemplate="{StaticResource DueAlertItemTemplate}"
                                 ItemContainerStyle="{StaticResource DueAlertListItemStyle}" MaxHeight="260"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                    </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
