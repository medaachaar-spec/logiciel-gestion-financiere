<Window x:Class="FinancialManagement.Desktop.Views.CustomerPaymentReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reçu d'encaissement"
        Width="430"
        Height="720"
        MinWidth="390"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F4F6">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Aperçu du reçu 80 mm"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <Border Grid.Row="1"
                Width="322"
                HorizontalAlignment="Center"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1">
            <FlowDocumentScrollViewer x:Name="ReceiptPreview"
                                      IsToolBarVisible="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="White" />
        </Border>
        <TextBlock x:Name="PrintStatus"
                   Grid.Row="2"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Foreground="#374151"
                   AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    Width="104"
                    Height="36"
                    Margin="0,0,8,0"
                    Content="Imprimer"
                    Click="PrintOnClick" />
            <Button Grid.Column="2"
                    Width="92"
                    Height="36"
                    Content="Fermer"
                    IsCancel="True"
                    Click="CloseOnClick" />
        </Grid>
    </Grid>
</Window>
