<UserControl x:Class="FinancialManagement.Desktop.Views.InitialObligationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="InitialObligationView_OnLoaded"
             Unloaded="InitialObligationView_OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="InitialObligationGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding Description}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Width="100" Height="34" Margin="12,0,8,0"
                        Content="Actualiser" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="2" Width="170" Height="34"
                        Content="Ajouter" Command="{Binding ShowCreateCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.Name="Ajouter un élément initial" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Height="34" Text="{Binding FilterPartySearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"
                         AutomationProperties.Name="Rechercher un tiers pour filtrer" />
                <ComboBox Grid.Column="1" Height="34" Margin="8,0,0,0"
                          ItemsSource="{Binding FilterPartyResults}"
                          SelectedItem="{Binding SelectedFilterPartyResult}"
                          DisplayMemberPath="DisplayLabel" Style="{StaticResource InputComboBoxStyle}"
                          AutomationProperties.Name="Tiers à utiliser comme filtre" />
                <Button Grid.Column="2" Width="96" Height="34" Margin="8,0,0,0"
                        Content="Rechercher" Command="{Binding SearchFilterPartiesCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="3" Width="78" Height="34" Margin="8,0,0,0"
                        Content="Filtrer" Command="{Binding ApplyPartyFilterCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Column="4" Width="110" Height="34" Margin="8,0,0,0"
                        HorizontalAlignment="Left" Content="Tout afficher"
                        Command="{Binding ClearPartyFilterCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,8,0,8">
                <ProgressBar Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border Margin="0,8,0,0" Padding="9" Background="#FFF7F7" CornerRadius="6"
                        Visibility="{Binding HasListError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ListErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>
                <Border Margin="0,8,0,0" Padding="9" Background="{StaticResource SuccessSoftBrush}" CornerRadius="6"
                        Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource InitialObligationGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                          EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="1.05*" />
                        <DataGridTextColumn Header="Client / Fournisseur" Binding="{Binding PartyName}" Width="1.35*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" Width="90" />
                        <DataGridTextColumn Header="Montant initial" Binding="{Binding InitialAmount}" Width="112" />
                        <DataGridTextColumn Header="Reste" Binding="{Binding OutstandingAmount}" Width="105" />
                        <DataGridTextColumn Header="Échéance" Binding="{Binding DueDate}" Width="92" />
                        <DataGridTextColumn Header="Observation" Binding="{Binding Observation}" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Padding="22" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding EmptyMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TotalLabel}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Grid.Column="1" Width="96" Height="32" Content="Précédent"
                        Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock Grid.Column="2" Width="100" Text="{Binding PageLabel}"
                           TextAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="3" Width="96" Height="32" Content="Suivant"
                        Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Grid>

        <Grid Background="#66000000"
              Visibility="{Binding IsCreateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Margin="18" Padding="22" MaxWidth="760" MaxHeight="570"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" KeyboardNavigation.TabNavigation="Cycle">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title, StringFormat=Nouvelle saisie — {0}}"
                                       FontSize="21" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Width="90" Height="32" Content="Annuler"
                                    Command="{Binding CancelCreateCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <Border Margin="0,12,0,0" Padding="9" Background="#FFF7F7" CornerRadius="6"
                                Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding FormErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Label Margin="0,12,0,0" Content="Recherche du tiers"
                               Target="{Binding ElementName=PartySearchInput}" Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PartySearchInput" Height="36" TabIndex="10"
                                     Text="{Binding PartySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <Button Grid.Column="1" Width="110" Height="36" Margin="10,0,0,0"
                                    Content="Rechercher" Command="{Binding SearchPartiesCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Height="36" ItemsSource="{Binding PartyResults}"
                                      SelectedItem="{Binding SelectedPartyResult}"
                                      DisplayMemberPath="DisplayLabel" Style="{StaticResource InputComboBoxStyle}"
                                      AutomationProperties.Name="Résultats de recherche du tiers" />
                            <Button Grid.Column="1" Width="110" Height="36" Margin="10,0,0,0"
                                    Content="Sélectionner" Command="{Binding SelectPartyCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Text="{Binding SelectedPartyLabel}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="Montant initial *" Target="{Binding ElementName=AmountInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="AmountInput" Height="36" TabIndex="11"
                                         Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Date *" Target="{Binding ElementName=BusinessDateInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <DatePicker x:Name="BusinessDateInput" Height="36" TabIndex="12"
                                            SelectedDate="{Binding BusinessDate}"
                                            Style="{StaticResource InputDatePickerStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <Label Content="Échéance" Target="{Binding ElementName=DueDateInput}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <DatePicker x:Name="DueDateInput" Height="36" TabIndex="13"
                                            SelectedDate="{Binding DueDate}"
                                            Style="{StaticResource InputDatePickerStyle}" />
                            </StackPanel>
                        </Grid>

                        <Label Margin="0,12,0,0" Content="Observation" Target="{Binding ElementName=ObservationInput}"
                               Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="ObservationInput" Height="62" TabIndex="14" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,7"
                                 Text="{Binding Observation, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" />

                        <ProgressBar Margin="0,12,0,0" Height="4" IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="96" Height="34" Margin="0,0,10,0" Content="Annuler"
                                    Command="{Binding CancelCreateCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Width="170" Height="34" Content="Enregistrer"
                                    Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
