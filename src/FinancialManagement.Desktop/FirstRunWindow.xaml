<Window x:Class="FinancialManagement.Desktop.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Première initialisation — Gestion financière"
        Width="520"
        Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Border Width="432"
                Margin="24"
                Padding="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel>
                <Border Width="48" Height="48" HorizontalAlignment="Left"
                        Background="{StaticResource PrimarySoftBrush}" CornerRadius="10">
                    <TextBlock Text="&#xE77B;" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}" FontSize="21"
                               Foreground="{StaticResource PrimaryBrush}" />
                </Border>
                <TextBlock Margin="0,20,0,4" Text="PREMIÈRE INITIALISATION"
                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text="Créer le Responsable" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,8,0,22"
                           Text="Ce compte unique permet de terminer la configuration et d'administrer l'application."
                           Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />

                <Label Content="Nom complet *" Target="{Binding ElementName=FullNameInput}"
                       Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="FullNameInput" Height="42" TabIndex="0"
                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"
                         AutomationProperties.Name="Nom complet du Responsable" />

                <Label Margin="0,12,0,0" Content="Nom d'utilisateur *"
                       Target="{Binding ElementName=UsernameInput}" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="UsernameInput" Height="42" TabIndex="1"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"
                         AutomationProperties.Name="Nom d'utilisateur du Responsable" />

                <Label Margin="0,12,0,0" Content="Mot de passe *"
                       Target="{Binding ElementName=PasswordInput}" Style="{StaticResource FieldLabelStyle}" />
                <PasswordBox x:Name="PasswordInput" Height="42" TabIndex="2"
                             Style="{StaticResource InputPasswordBoxStyle}"
                             AutomationProperties.Name="Mot de passe" />

                <Label Margin="0,12,0,0" Content="Confirmer le mot de passe *"
                       Target="{Binding ElementName=ConfirmationInput}" Style="{StaticResource FieldLabelStyle}" />
                <PasswordBox x:Name="ConfirmationInput" Height="42" TabIndex="3"
                             Style="{StaticResource InputPasswordBoxStyle}"
                             AutomationProperties.Name="Confirmation du mot de passe" />

                <Border Margin="0,14,0,0" Padding="10" Background="#FFF7F7" CornerRadius="7"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>
                <Border Margin="0,14,0,0" Padding="10" Background="{StaticResource SuccessSoftBrush}"
                        CornerRadius="7"
                        Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Button Margin="0,20,0,0" Height="44" TabIndex="4" IsDefault="True"
                        Content="{Binding SubmitButtonText}" Style="{StaticResource PrimaryButtonStyle}"
                        Click="SubmitButton_OnClick"
                        AutomationProperties.Name="Créer le premier Responsable" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
