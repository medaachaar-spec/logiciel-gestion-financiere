<Application x:Class="FinancialManagement.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FinancialManagement.Desktop.ViewModels"
             xmlns:views="clr-namespace:FinancialManagement.Desktop.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
                <views:PlaceholderPageView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
