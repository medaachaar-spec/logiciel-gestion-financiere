<Window x:Class="FinancialManagement.Desktop.InitializationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration initiale — Tresoria"
        Icon="Resources/Branding/TresoriaAppIcon.ico"
        Width="660"
        Height="600"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Border Margin="28" Padding="30" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="CONFIGURATION REQUISE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Margin="0,6,0,0" Text="Soldes d'ouverture" FontSize="28"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Renseignez les soldes réels de départ. Les montants positifs, nuls et négatifs sont acceptés. Cette opération ne pourra pas être remplacée depuis cet écran."
                               Style="{StaticResource BodyTextStyle}" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,20,0,0" Padding="14"
                        Background="{StaticResource PrimarySoftBrush}" CornerRadius="8">
                    <TextBlock Text="Les créances et dettes initiales sont facultatives et pourront être ajoutées ensuite depuis Administration."
                               TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <Label Content="Date d'ouverture *" Target="{Binding ElementName=OpeningDateInput}"
                           Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker x:Name="OpeningDateInput" Height="40" TabIndex="0"
                                SelectedDate="{Binding OpeningDate}" Style="{StaticResource InputDatePickerStyle}"
                                AutomationProperties.Name="Date d'ouverture" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="Solde initial Caisse *" Target="{Binding ElementName=CashInput}"
                                   Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="CashInput" Height="40" TabIndex="1"
                                     Text="{Binding CashAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     AutomationProperties.Name="Solde initial Caisse" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Solde initial Banque *" Target="{Binding ElementName=BankInput}"
                                   Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="BankInput" Height="40" TabIndex="2"
                                     Text="{Binding BankAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     AutomationProperties.Name="Solde initial Banque" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <Border Padding="10" Background="#FFF7F7" CornerRadius="7"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Border Padding="10" Background="{StaticResource SuccessSoftBrush}" CornerRadius="7"
                            Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <ProgressBar Margin="0,12,0,0" Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="190" Height="40" TabIndex="3" IsDefault="True"
                            Content="{Binding SaveButtonText}" Command="{Binding RequestSaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Enregistrer les soldes d'ouverture" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Background="#66000000"
              Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="480" Padding="24" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Enregistrer les soldes d'ouverture ?" FontSize="21"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Caisse initiale" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding ConfirmationCashAmount}"
                                       FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Banque initiale" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding ConfirmationBankAmount}"
                                       FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,14,0,0" Text="{Binding ConfirmationDate}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="100" Height="36" Margin="0,0,10,0" Content="Retour"
                                Command="{Binding CancelConfirmationCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Width="190" Height="36" Content="Confirmer l'enregistrement"
                                Command="{Binding ConfirmSaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
