<Window x:Class="FinancialManagement.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion — Tresoria"
        Icon="Resources/Branding/TresoriaAppIcon.ico"
        Width="480"
        Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="LoginCard"
                Width="400"
                Margin="32"
                Padding="42,38,42,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="5"
                                  Opacity="0.11"
                                  Color="#17212B" />
            </Border.Effect>
            <StackPanel>
                <Border Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Image x:Name="LoginBrandIcon"
                           Width="66"
                           Height="66"
                           Source="Resources/Branding/TresoriaAppIcon.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Symbole Tresoria"
                           IsHitTestVisible="False" />
                </Border>

                <TextBlock Margin="0,18,0,6"
                           Text="TRESORIA"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Connexion"
                           FontSize="29"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,8,0,30"
                           Text="Accédez à votre espace de gestion."
                           Style="{StaticResource BodyTextStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />

                <TextBlock Margin="0,0,0,8"
                           Text="Nom d'utilisateur"
                           Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="UsernameInput"
                          Height="46"
                         TabIndex="0"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"
                         AutomationProperties.Name="Nom d'utilisateur" />

                <TextBlock Margin="0,20,0,8"
                           Text="Mot de passe"
                           Style="{StaticResource FieldLabelTextStyle}" />
                <Grid Height="46">
                    <PasswordBox x:Name="PasswordInput"
                                 Padding="12,0,48,0"
                                 TabIndex="1"
                                 Style="{StaticResource InputPasswordBoxStyle}"
                                 AutomationProperties.Name="Mot de passe" />
                    <TextBox x:Name="VisiblePasswordInput"
                             Padding="12,0,48,0"
                             TabIndex="1"
                             Style="{StaticResource InputTextBoxStyle}"
                             Visibility="Collapsed"
                             AutomationProperties.Name="Mot de passe visible" />
                    <ToggleButton x:Name="PasswordVisibilityToggle"
                                  Width="38"
                                  Height="38"
                                  Margin="0,4,4,4"
                                  Padding="0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Stretch"
                                  Panel.ZIndex="1"
                                  TabIndex="3"
                                  IsChecked="False"
                                  Focusable="True"
                                  IsTabStop="True"
                                  Background="Transparent"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  ToolTip="Afficher le mot de passe"
                                  AutomationProperties.Name="Afficher le mot de passe"
                                  Checked="PasswordVisibilityToggle_OnChecked"
                                  Unchecked="PasswordVisibilityToggle_OnUnchecked">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="ToggleSurface"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Grid Width="18" Height="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid x:Name="ShowPasswordIcon">
                                            <Path Data="M1,9 C3.8,4.6 6.2,3 9,3 C11.8,3 14.2,4.6 17,9 C14.2,13.4 11.8,15 9,15 C6.2,15 3.8,13.4 1,9 Z"
                                                  Fill="Transparent"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" />
                                            <Ellipse Width="5" Height="5"
                                                     Fill="Transparent"
                                                     Stroke="{TemplateBinding Foreground}"
                                                     StrokeThickness="1.5" />
                                        </Grid>
                                        <Grid x:Name="HidePasswordIcon" Visibility="Collapsed">
                                            <Path Data="M1,9 C3.8,4.6 6.2,3 9,3 C11.8,3 14.2,4.6 17,9 C14.2,13.4 11.8,15 9,15 C6.2,15 3.8,13.4 1,9 Z"
                                                  Fill="Transparent"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" />
                                            <Ellipse Width="5" Height="5"
                                                     Fill="Transparent"
                                                     Stroke="{TemplateBinding Foreground}"
                                                     StrokeThickness="1.5" />
                                            <Line X1="2" Y1="2" X2="16" Y2="16"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ShowPasswordIcon" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="HidePasswordIcon" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ToggleSurface" Property="Background" Value="{StaticResource BackgroundBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Setter TargetName="ToggleSurface" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ToggleSurface" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>

                <Border Margin="0,18,0,0"
                        Padding="12,10"
                        Background="#FFF7F7"
                        BorderBrush="#F1D3D3"
                        BorderThickness="1"
                        CornerRadius="7"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </Border>

                <Button x:Name="SignInButton"
                        Margin="0,26,0,0"
                        Height="48"
                        TabIndex="2"
                        IsDefault="True"
                        IsEnabled="{Binding CanSubmit}"
                        Content="{Binding SubmitButtonText}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SignInButton_OnClick"
                        AutomationProperties.Name="Se connecter" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
