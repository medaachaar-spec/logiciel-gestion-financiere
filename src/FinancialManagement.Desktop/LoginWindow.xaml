<Window x:Class="FinancialManagement.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion — Tresoria"
        Icon="Resources/Branding/TresoriaAppIcon.ico"
        Width="480"
        Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="LoginCard"
                Width="400"
                Margin="32"
                Padding="42,38,42,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="5"
                                  Opacity="0.11"
                                  Color="#17212B" />
            </Border.Effect>
            <StackPanel>
                <Border Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Image x:Name="LoginBrandIcon"
                           Width="66"
                           Height="66"
                           Source="Resources/Branding/TresoriaAppIcon.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Symbole Tresoria"
                           IsHitTestVisible="False" />
                </Border>

                <TextBlock Margin="0,18,0,6"
                           Text="TRESORIA"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Connexion"
                           FontSize="29"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,8,0,30"
                           Text="Accédez à votre espace de gestion."
                           Style="{StaticResource BodyTextStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />

                <TextBlock Margin="0,0,0,8"
                           Text="Nom d'utilisateur"
                           Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="UsernameInput"
                          Height="46"
                         TabIndex="0"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"
                         AutomationProperties.Name="Nom d'utilisateur" />

                <TextBlock Margin="0,20,0,8"
                           Text="Mot de passe"
                           Style="{StaticResource FieldLabelTextStyle}" />
                <PasswordBox x:Name="PasswordInput"
                              Height="46"
                             TabIndex="1"
                             Style="{StaticResource InputPasswordBoxStyle}"
                             AutomationProperties.Name="Mot de passe" />

                <Border Margin="0,18,0,0"
                        Padding="12,10"
                        Background="#FFF7F7"
                        BorderBrush="#F1D3D3"
                        BorderThickness="1"
                        CornerRadius="7"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </Border>

                <Button Margin="0,26,0,0"
                        Height="48"
                        TabIndex="2"
                        IsDefault="True"
                        IsEnabled="{Binding CanSubmit}"
                        Content="{Binding SubmitButtonText}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SignInButton_OnClick"
                        AutomationProperties.Name="Se connecter" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
