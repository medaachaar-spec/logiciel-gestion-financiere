<Window x:Class="FinancialManagement.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion — Gestion financière"
        Width="480"
        Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Border Width="400"
                Margin="24"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel>
                <Border Width="48"
                        Height="48"
                        HorizontalAlignment="Left"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="10">
                    <TextBlock Text="&#xE72E;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="21"
                               Foreground="{StaticResource PrimaryBrush}" />
                </Border>

                <TextBlock Margin="0,22,0,4"
                           Text="GESTION FINANCIÈRE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text="Connexion"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,8,0,28"
                           Text="Accédez à votre espace de gestion."
                           Style="{StaticResource BodyTextStyle}" />

                <TextBlock Margin="0,0,0,7"
                           Text="Nom d'utilisateur"
                           Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="UsernameInput"
                         Height="44"
                         TabIndex="0"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"
                         AutomationProperties.Name="Nom d'utilisateur" />

                <TextBlock Margin="0,18,0,7"
                           Text="Mot de passe"
                           Style="{StaticResource FieldLabelTextStyle}" />
                <PasswordBox x:Name="PasswordInput"
                             Height="44"
                             TabIndex="1"
                             Style="{StaticResource InputPasswordBoxStyle}"
                             AutomationProperties.Name="Mot de passe" />

                <Border Margin="0,18,0,0"
                        Padding="12,10"
                        Background="#FFF7F7"
                        BorderBrush="#F1D3D3"
                        BorderThickness="1"
                        CornerRadius="7"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </Border>

                <Button Margin="0,24,0,0"
                        Height="46"
                        TabIndex="2"
                        IsDefault="True"
                        IsEnabled="{Binding CanSubmit}"
                        Content="{Binding SubmitButtonText}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SignInButton_OnClick"
                        AutomationProperties.Name="Se connecter" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
