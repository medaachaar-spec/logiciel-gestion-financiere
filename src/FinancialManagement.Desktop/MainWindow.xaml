<Window x:Class="FinancialManagement.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tresoria"
        Icon="Resources/Branding/TresoriaAppIcon.ico"
        Width="1366"
        Height="768"
        MinWidth="1024"
        MinHeight="640"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Width="216"
                      Margin="16,16,16,14"
                      HorizontalAlignment="Center">
                    <Image x:Name="SidebarBrandLogo"
                           Width="190"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="Resources/Branding/TresoriaSidebarLogo.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Logo Tresoria"
                           IsHitTestVisible="False" />
                </Grid>

                <Border Grid.Row="1"
                        Height="1"
                        Margin="20,0"
                        Background="#354653" />

                <ScrollViewer Grid.Row="2"
                              Padding="14,16,14,20"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.Name="{Binding Title}"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource NavigationButtonStyle}"
                                        ToolTip="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="24"
                                                   Text="{Binding IconGlyph}"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="16"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Espace de gestion"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12.5"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="14,8"
                            VerticalAlignment="Center"
                            Background="#F7F9FB"
                            BorderBrush="#E7EBEF"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="Session active"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10.5" />
                            <TextBlock Text="{Binding AuthenticatedUsername}"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2"
                            Width="126"
                            Height="36"
                            Margin="16,0,0,0"
                            Content="Se déconnecter"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="Se déconnecter" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Margin="26,22,24,24"
                            Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
